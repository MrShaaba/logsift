# logsift needs no secrets. These are optional overrides for `logsift serve`.
LOGSIFT_HOST=127.0.0.1
LOGSIFT_PORT=8000
# Where uploaded files (uploads/) and loaded tables (db/) are kept (ignored by git).
LOGSIFT_DATA_DIR=data
# Rows loaded for the first look at a file in the web UI before "Run the full pass".
LOGSIFT_SAMPLE_ROWS=250000
